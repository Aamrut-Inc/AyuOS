# AyuOS runs its own database (no Docker); set DATABASE_URL only to use an
# external Postgres instead.
# DATABASE_URL=

# Oura / Whoop app credentials (shared by the team — ask; scripts/start.command
# prompts for them). Registered redirect: http://localhost:8000/api/v1/oauth/<provider>/callback
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# EHR/FHIR — hospital records via Epic MyChart. Pick your hospital in the app
# ("+ Add a hospital" on the home page). These identify the "AyuOS Full Record"
# app on Open Epic; client IDs are public identifiers, not secrets.
FHIR_CLIENT_ID=92928c9b-8eb2-4b11-b06a-c388150d45ce
FHIR_SANDBOX_CLIENT_ID=d46a179a-92c3-4e15-90a3-ccb765e8e1ce
# https forwarding page registered with Epic; it hands the login back to the
# app listening on http://127.0.0.1:8765 (override with FHIR_CALLBACK_LISTEN_URI).
FHIR_REDIRECT_URI=https://ishaan-netizen.github.io/ayuos-callback/
# Optional: pre-select one hospital without using the picker (CLI imports use it).
# FHIR_PROVIDER=stanford
# FHIR_BASE_URL=https://sfd.stanfordmed.org/FHIR/api/FHIR/R4
# Optional overrides. By default every relevant patient resource type and every
# Observation category is fetched (see extract/ehr/config.ts), and scopes are
# derived from the resource types. Types/categories the server or the granted
# scopes don't allow are skipped. Each type must also be enabled as an API on
# the Epic app registration, or Epic won't grant it.
# FHIR_RESOURCE_TYPES=Patient,Observation,Condition
# FHIR_OBSERVATION_CATEGORIES=laboratory,vital-signs
# FHIR_SCOPES=launch/patient openid fhirUser patient/Patient.rs patient/Observation.rs
