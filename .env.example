# Local Postgres connection used by load/.
# Matches the ayuos-db service in docker-compose.yml (docker compose up -d).
DATABASE_URL=postgres://ayuos:ayuos@localhost:5433/ayuos

# Open Wearables (services/wearables) instance to read synced wearable data from.
# The local default below matches the wearables-app service in docker-compose.yml.
# OPEN_WEARABLES_API_KEY is not a static secret: it's created by running
# services/wearables/scripts/create-dev-api-key.sh after `docker compose up -d`.
OPEN_WEARABLES_API_BASE_URL=http://localhost:8000
OPEN_WEARABLES_API_KEY=
OPEN_WEARABLES_USER_ID=

# EHR/FHIR — your hospital's patient records (Epic). Client IDs are public
# identifiers of the "AyuOS Full Record" app on Open Epic, not secrets.
#
# Your real hospital (see docs/tester-setup.md, "Connecting your hospital"):
#   FHIR_PROVIDER     a short name you choose, e.g. stanford
#   FHIR_BASE_URL     your hospital's "R4" address from https://open.epic.com/MyApps/Endpoints
FHIR_PROVIDER=stanford
FHIR_BASE_URL=https://sfd.stanfordmed.org/FHIR/api/FHIR/R4
FHIR_CLIENT_ID=92928c9b-8eb2-4b11-b06a-c388150d45ce
FHIR_REDIRECT_URI=https://ishaan-netizen.github.io/ayuos-callback/
#
# Epic's test sandbox instead (fake patients, e.g. user fhircamila / epicepic1):
# FHIR_PROVIDER=epic_sandbox
# FHIR_BASE_URL=https://fhir.epic.com/interconnect-fhir-oauth/api/FHIR/R4
# FHIR_CLIENT_ID=d46a179a-92c3-4e15-90a3-ccb765e8e1ce
# FHIR_REDIRECT_URI=http://127.0.0.1:8765
#
# The https redirect is a forwarding page that hands the login back to the app
# listening on http://127.0.0.1:8765 (override with FHIR_CALLBACK_LISTEN_URI).
# Optional overrides. By default every relevant patient resource type and every
# Observation category is fetched (see extract/ehr/config.ts), and scopes are
# derived from the resource types. Types/categories the server or the granted
# scopes don't allow are skipped. Each type must also be enabled as an API on
# the Epic app registration, or Epic won't grant it.
# FHIR_RESOURCE_TYPES=Patient,Observation,Condition
# FHIR_OBSERVATION_CATEGORIES=laboratory,vital-signs
# FHIR_SCOPES=launch/patient openid fhirUser patient/Patient.rs patient/Observation.rs
